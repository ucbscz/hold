{
  "name": "ucb-hold.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "brand": "node tools/render-templates.mjs",
    "prestart": "node aspnetcore-https && npm run brand",
    "start": "ng serve",
    "prebuild": "npm run brand",
    "build": "ng build",
    "prewatch": "npm run brand",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage --watch=false --browsers=ChromeHeadlessNoSandbox",
    "format": "prettier --write \"**/*.{ts,html,css,json,js,mjs,cjs,scss,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,js,mjs,cjs,scss,md,yml,yaml}\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "flatpickr": "^4.6.13",
    "rxjs": "~7.8.0",
    "signature_pad": "^5.0.7",
    "ts-results-es": "^7.0.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "glob@>=9.0.0 <14.0.2": "14.0.3",
    "minimatch@>=9.0.0 <11.0.1": "11.0.4",
    "qs": "6.17.1",
    "uuid": "11.1.1"
  }
}
