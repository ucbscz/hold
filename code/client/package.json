{
  "name": "imt-reservas.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage --watch=false --browsers=ChromeHeadlessNoSandbox",
    "format": "prettier --write \"**/*.{ts,html,css,json,js,mjs,cjs,scss,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,js,mjs,cjs,scss,md,yml,yaml}\"",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve",
    "start:default": "ng serve"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/forms": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@angular/platform-browser-dynamic": "^21.2.21",
    "@angular/router": "^21.2.21",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "flatpickr": "^4.6.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "run-script-os": "*",
    "rxjs": "~7.8.0",
    "signature_pad": "^5.0.7",
    "ts-results-es": "^7.0.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
