POSTGRES_USER=<database-admin-user>
POSTGRES_PASSWORD=<database-admin-password>
POSTGRES_DB=<database-name>
APP_DB_USER=<application-role-created-by-schema>
APP_DB_PASSWORD=<application-role-password>
ConnectionStrings__PostgreSQL=Host=ucb_db;Port=5432;Database=<database-name>;Username=<application-role-created-by-schema>;Password=<application-role-password>;Pooling=true;MinPoolSize=2;MaxPoolSize=20
Jwt__Key=<at-least-32-random-characters>
Jwt__Issuer=UCB_Hold
Jwt__Audience=UCB_Hold_Client
Jwt__ExpiresInMinutes=15
Jwt__RefreshTokenExpiryDays=7
AllowedOrigins__0=http://localhost:4200
Authentication__Provider=Google
Authentication__FrontendUrl=http://localhost:4200
Authentication__InstitutionalDomain=<institutional-email-domain>
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Email__Enabled=false
Email__Provider=Smtp
Email__SenderName=<sender-display-name>
Email__Host=<smtp-host>
Email__Port=587
Email__Username=<smtp-user>
Email__Password=<smtp-password>
Email__From=<sender-address>
Email__EnableSsl=true
